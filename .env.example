# Official Meta Model API env name. META_API_KEY is accepted as an alias.
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1
META_ASR_MODEL=muse-voice-transcribe-1.0
META_SPARK_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1

# auto | muse | whisper | scripted
TAGLISH_TRANSCRIBER=scripted
# auto | muse | rules
TAGLISH_SPARK=auto
# auto | sam | fallback
TAGLISH_SEGMENTER=auto

LISTENER_URL=http://127.0.0.1:8747

